{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Sql": {
    "Server": "localhost",
    "Database": "master",
    "Encrypt": true,
    "TrustServerCertificate": false,
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 60,
    "IntegratorDatabase": "ambit-optima-integrator",
    "ConfigDatabase": "CDN_KNF_Konfiguracja",
    "LogRetentionDays": 30
  },
  "Writes": {
    "Enabled": false
  },
  "AmbitApi": {
    "Enabled": false,
    "BaseUrl": "",
    "PollSeconds": 30,
    "RetrySeconds": 60,
    "RequestTimeoutSeconds": 30
  }
}
